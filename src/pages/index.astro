---
import Layout from '../layouts/Layout.astro';
---

<Layout title="nikki1099 - Welcome">
    <div class="flex flex-col items-center justify-center py-12 sm:py-20 text-center">
        <h1 class="mb-6">Welcome to nikki1099.com</h1>
        <p class="text-lg sm:text-xl text-gray-300 max-w-2xl mb-10 leading-relaxed">
            Hey there! This is my personal space on the web. Stay tuned as I build out this site with more content coming soon.
        </p>
        <div class="flex flex-wrap gap-4 justify-center">
            <a href="/about" class="btn btn-lg sm:min-w-48">About Me</a>
        </div>
    </div>
</Layout>

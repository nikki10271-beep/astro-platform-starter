---
import NikkiLayout from '../layouts/NikkiLayout.astro';

const credentials = [
    {
        title: "Experienced Administrative & Operations Professional",
        text: "Proven background supporting business operations, client communication, scheduling, reporting, workflow coordination, and day-to-day administrative needs across multiple industries.",
    },
    {
        title: "Customer Service & Hospitality Strength",
        text: "Polished, service-forward experience in customer support, guest-facing environments, membership sales, event coordination, and relationship management.",
    },
    {
        title: "Business Systems & Technical Proficiency",
        text: "Comfortable stepping into fast-moving environments using spreadsheets, CRM platforms, POS tools, scheduling systems, e-commerce dashboards, and cloud-based office tools.",
    },
    {
        title: "Dependable Contract Coverage",
        text: "Available for short-term projects, interim support, overflow work, seasonal needs, and longer-term temporary assignments requiring professionalism and adaptability.",
    },
];

const workTypes = [
    "Executive and administrative support",
    "Inbox, calendar, scheduling, and coordination help",
    "Customer service and customer success support",
    "Front desk, intake, and client communication coverage",
    "Spreadsheet, CRM, and database management",
    "Order processing, e-commerce, and operations support",
    "Event, hospitality, and guest services assistance",
    "Short-term project work and long-term temporary placements",
];

const highlights = [
    "Professional, polished communication",
    "Fast ramp-up in new environments",
    "Organized and detail-focused execution",
    "Strong service mindset",
];
---

<NikkiLayout title="Nikki1099 — Administrative & Hospitality Solutions">
    <div class="min-h-screen bg-white text-neutral-900">
        <header class="sticky top-0 z-20 border-b border-neutral-200 bg-white/90 backdrop-blur-sm">
            <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4 lg:px-10">
                <div class="flex items-center gap-4">
                    <img
                        src="/images/nikki1099-logo.jpg"
                        alt="Nikki1099 logo"
                        class="h-12 w-auto object-contain"
                    />
                    <div>
                        <div class="text-lg font-semibold tracking-tight">Nikki1099</div>
                        <div class="text-xs uppercase tracking-[0.22em] text-neutral-500">Administrative & Hospitality Solutions</div>
                    </div>
                </div>

                <nav class="hidden items-center gap-8 text-sm text-neutral-600 md:flex">
                    <a href="#credentials" class="no-underline transition hover:text-neutral-900">Credentials</a>
                    <a href="#services" class="no-underline transition hover:text-neutral-900">Services</a>
                    <a href="#contact" class="no-underline transition hover:text-neutral-900">Contact</a>
                </nav>
            </div>
        </header>

        <section class="relative overflow-hidden border-b border-neutral-200 bg-[linear-gradient(180deg,#ffffff_0%,#f7f7f7_100%)]">
            <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,rgba(0,0,0,0.05),transparent_28%)]"></div>
            <div class="relative mx-auto grid max-w-7xl gap-16 px-6 py-20 lg:grid-cols-[1.1fr_0.9fr] lg:px-10 lg:py-28">
                <div>
                    <div class="inline-flex items-center rounded-full border border-neutral-300 bg-white px-4 py-2 text-xs font-medium uppercase tracking-[0.24em] text-neutral-600 shadow-sm">
                        Contract Administrative & Hospitality Support
                    </div>
                    <h1 class="mt-8 max-w-4xl text-5xl font-semibold tracking-tight text-neutral-950 sm:text-6xl">
                        Reliable professional support for businesses that need capable help right away.
                    </h1>
                    <p class="mt-6 max-w-2xl text-lg leading-8 text-neutral-600">
                        Nikki1099 provides polished, experienced support for short-term and long-term temporary roles in administration, customer service, operations, and hospitality-focused work.
                    </p>

                    <div class="mt-10 flex flex-wrap gap-4">
                        <a
                            href="#services"
                            class="no-underline rounded-2xl bg-neutral-950 px-6 py-3 text-sm font-medium text-white shadow-md transition hover:opacity-90 hover:-translate-y-0.5"
                        >
                            Explore Services
                        </a>
                        <a
                            href="#credentials"
                            class="no-underline rounded-2xl border border-neutral-300 bg-white px-6 py-3 text-sm font-medium text-neutral-800 shadow-sm transition hover:bg-neutral-50"
                        >
                            View Credentials
                        </a>
                    </div>

                    <div class="mt-12 grid gap-3 sm:grid-cols-2">
                        {highlights.map((item) => (
                            <div class="rounded-2xl border border-neutral-200 bg-white px-4 py-4 text-sm text-neutral-700 shadow-sm">
                                {item}
                            </div>
                        ))}
                    </div>
                </div>

                <div class="flex items-center">
                    <div class="w-full rounded-[2rem] border border-neutral-200 bg-white p-8 shadow-[0_20px_60px_rgba(0,0,0,0.08)]">
                        <div class="flex items-center justify-between border-b border-neutral-200 pb-5">
                            <div>
                                <div class="text-sm uppercase tracking-[0.2em] text-neutral-500">Ideal For</div>
                                <h2 class="mt-2 text-2xl font-semibold tracking-tight">Flexible business coverage</h2>
                            </div>
                            <img
                                src="/images/nikki1099-logo.jpg"
                                alt="Nikki1099 symbol"
                                class="h-14 w-auto object-contain opacity-90"
                            />
                        </div>

                        <div class="mt-6 space-y-4 text-neutral-700">
                            <div class="rounded-2xl bg-neutral-50 p-4">Temporary administrative support during transitions, leave coverage, or high-volume periods</div>
                            <div class="rounded-2xl bg-neutral-50 p-4">Hospitality and guest-facing service help for events, clubs, venues, and member-based organizations</div>
                            <div class="rounded-2xl bg-neutral-50 p-4">Operational support for businesses that need an experienced professional without making an immediate permanent hire</div>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <section id="credentials" class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
            <div class="mb-12 max-w-3xl">
                <div class="text-sm uppercase tracking-[0.2em] text-neutral-500">Credentials</div>
                <h2 class="mt-3 text-4xl font-semibold tracking-tight">A background built for service, organization, and execution.</h2>
                <p class="mt-4 text-lg leading-8 text-neutral-600">
                    Nikki1099 is designed for businesses that need someone who can walk in, learn quickly, communicate professionally, and provide dependable support across administrative and hospitality-driven functions.
                </p>
            </div>

            <div class="grid gap-6 md:grid-cols-2">
                {credentials.map((item) => (
                    <div class="rounded-[1.75rem] border border-neutral-200 bg-white p-8 shadow-sm transition hover:shadow-md">
                        <h3 class="text-xl font-semibold tracking-tight text-neutral-900">{item.title}</h3>
                        <p class="mt-4 leading-7 text-neutral-600">{item.text}</p>
                    </div>
                ))}
            </div>
        </section>

        <section id="services" class="border-y border-neutral-200 bg-neutral-50">
            <div class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
                <div class="mb-12 max-w-3xl">
                    <div class="text-sm uppercase tracking-[0.2em] text-neutral-500">Types of Work Available</div>
                    <h2 class="mt-3 text-4xl font-semibold tracking-tight">Flexible support tailored to what your business needs most.</h2>
                    <p class="mt-4 text-lg leading-8 text-neutral-600">
                        From front-facing service to behind-the-scenes organization, Nikki1099 offers contract support that can strengthen day-to-day operations immediately.
                    </p>
                </div>

                <div class="grid gap-5 md:grid-cols-2">
                    {workTypes.map((item) => (
                        <div class="rounded-[1.75rem] border border-neutral-200 bg-white p-6 shadow-sm">
                            <div class="flex items-start gap-4">
                                <div class="mt-1.5 h-3 w-3 shrink-0 rounded-full bg-neutral-900"></div>
                                <p class="text-base leading-7 text-neutral-700">{item}</p>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>

        <section class="mx-auto max-w-7xl px-6 py-20 lg:px-10">
            <div class="grid gap-8 lg:grid-cols-[1fr_0.9fr]">
                <div class="rounded-[2rem] border border-neutral-200 bg-white p-10 shadow-sm">
                    <div class="text-sm uppercase tracking-[0.2em] text-neutral-500">Why Nikki1099</div>
                    <h2 class="mt-3 text-3xl font-semibold tracking-tight">A contract professional who combines administrative skill with hospitality polish.</h2>
                    <p class="mt-5 text-lg leading-8 text-neutral-600">
                        The Nikki1099 brand is built around being adaptable, organized, approachable, and ready to contribute in environments where details, timing, and professional service matter.
                    </p>
                </div>

                <div class="rounded-[2rem] border border-neutral-200 bg-neutral-950 p-10 text-white shadow-sm">
                    <div class="text-sm uppercase tracking-[0.2em] text-neutral-400">Availability</div>
                    <h2 class="mt-3 text-3xl font-semibold tracking-tight">Short-term or long-term temporary placements.</h2>
                    <p class="mt-5 leading-8 text-neutral-300">
                        Ideal for overflow support, special projects, temporary staffing gaps, seasonal demand, guest services support, and operations coverage.
                    </p>
                </div>
            </div>
        </section>

        <section id="contact" class="bg-neutral-950">
            <div class="mx-auto max-w-7xl px-6 py-18 lg:px-10">
                <div class="rounded-[2rem] border border-white/10 bg-[linear-gradient(180deg,rgba(255,255,255,0.08),rgba(255,255,255,0.03))] p-10 text-white shadow-[0_20px_60px_rgba(0,0,0,0.25)]">
                    <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-center">
                        <div>
                            <div class="text-sm uppercase tracking-[0.2em] text-neutral-400">Let's Connect</div>
                            <h2 class="mt-3 text-4xl font-semibold tracking-tight">Need experienced temporary support?</h2>
                            <p class="mt-4 max-w-2xl text-lg leading-8 text-neutral-300">
                                Nikki1099 is available for administrative, operational, customer-facing, and hospitality-related contract work. Add your preferred email, LinkedIn, or booking details here to turn this into a live inquiry section.
                            </p>
                        </div>

                        <div class="rounded-[1.75rem] border border-white/10 bg-white/5 p-8">
                            <div class="space-y-4 text-neutral-200">
                                <div>
                                    <div class="text-xs uppercase tracking-[0.2em] text-neutral-500">Location</div>
                                    <div class="mt-2 text-base">Ann Arbor, Michigan</div>
                                </div>
                                <div>
                                    <div class="text-xs uppercase tracking-[0.2em] text-neutral-500">Work Style</div>
                                    <div class="mt-2 text-base">Short-term, project-based, and long-term temporary placements</div>
                                </div>
                                <div>
                                    <div class="text-xs uppercase tracking-[0.2em] text-neutral-500">Next Step</div>
                                    <div class="mt-2 text-base">Add email, phone, intake form, or LinkedIn profile</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </div>
</NikkiLayout>
